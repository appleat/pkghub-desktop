{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PkgHub",
  "version": "1.0.0",
  "identifier": "com.pkghub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PkgHub · 本地安装包管理",
        "width": 1400,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Light",
        "backgroundColor": "#f6f7fb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PkgHub",
    "copyright": "PkgHub",
    "category": "Utility",
    "shortDescription": "本地安装包管理器",
    "longDescription": "扫描、分类、管理本机的软件安装包，一键启动安装程序。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
